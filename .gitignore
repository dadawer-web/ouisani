# ── Secrets / 环境变量 ──
.env
.env.*
!.env.example

# ── Java / Maven ──
target/
*.class
*.jar
*.war
*.ear
*.nar
dependency-reduced-pom.xml
.mvn/wrapper/maven-wrapper.jar
hs_err_pid*
replay_pid*

# ── Node / Frontend ──
node_modules/
dist/
dist-ssr/
*.local

# ── Python ──
.venv/
venv/
__pycache__/
*.pyc
*.pyo

# ── Models / Binaries ──
models/
*.gguf
*.bin
llama.cpp/

# ── OS / Editor ──
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ── Native compiled ──
*.o
*.out
*.wasm
*.so
*.a

# ── Runtime ──
snapshots/
swap/
/tmp/

# ── AIOS 运行时数据（不应上传）──
# workspaces/ — Agent 任务运行时输出（每次任务生成的 factory 产物）
workspaces/
# openclaw_sessions/ — 会话日志（jsonl 格式）
openclaw_sessions/
# var/ — 运行时状态（PID、plan 持久化测试产物、安全裁决文件等）
var/
# *.jsonl — 通用会话/日志格式
*.jsonl

# ── IDE 内部文档（规划/计划文件，非源码）──
.trae/

# ── LaTeX / 论文目录（全部忽略）──
paper/
