<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>番茄钟 Web 应用</title>
    <link rel="stylesheet" href="css/style.css">
</head>
<body>
    <div class="container">
        <h1>🍅 番茄钟</h1>
        
        <div class="timer-display">
            <div class="time-circle">
                <svg viewBox="0 0 100 100">
                    <circle cx="50" cy="50" r="45" fill="none" stroke="#eee" stroke-width="8"/>
                    <circle cx="50" cy="50" r="45" fill="none" stroke="#ff6b6b" stroke-width="8" 
                            stroke-dasharray="283" stroke-dashoffset="0" 
                            stroke-linecap="round" transform="rotate(-90 50 50)"/>
                </svg>
                <div class="time-text">
                    <span id="minutes">25</span>:<span id="seconds">00</span>
                </div>
            </div>
        </div>

        <div class="controls">
            <button id="startBtn" class="btn btn-start">开始</button>
            <button id="pauseBtn" class="btn btn-pause" disabled>暂停</button>
            <button id="resetBtn" class="btn btn-reset">重置</button>
        </div>

        <div class="session-info">
            <p>当前阶段: <span id="currentSession">工作</span></p>
            <p>已完成番茄: <span id="completedPomodoros">0</span></p>
        </div>

        <div class="settings">
            <h3>设置</h3>
            <div class="setting-item">
                <label>工作时间(分钟):</label>
                <input type="number" id="workTime" value="25" min="1" max="60">
            </div>
            <div class="setting-item">
                <label>短休息时间(分钟):</label>
                <input type="number" id="breakTime" value="5" min="1" max="30">
            </div>
            <div class="setting-item">
                <label>长休息时间(分钟):</label>
                <input type="number" id="longBreakTime" value="15" min="1" max="30">
            </div>
            <div class="setting-item">
                <label>长休息间隔:</label>
                <input type="number" id="longBreakInterval" value="4" min="1" max="10">
            </div>
            <button id="saveSettingsBtn" class="btn btn-save">保存设置</button>
        </div>

        <div class="history">
            <h3>历史记录</h3>
            <div id="historyList"></div>
        </div>
    </div>

    <script src="js/app.js"></script>
</body>
</html>
</tool_result>
