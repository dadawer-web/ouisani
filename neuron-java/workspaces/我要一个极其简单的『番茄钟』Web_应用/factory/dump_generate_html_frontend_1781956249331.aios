/* 基础重置和全局样式 */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
}

.container {
    background: white;
    border-radius: 20px;
    padding: 30px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    width: 100%;
    max-width: 500px;
    text-align: center;
}

h1 {
    color: #333;
    margin-bottom: 30px;
    font-size: 2.5em;
}

/* 计时器样式 */
.timer-display {
    margin: 30px 0;
}

.time-circle {
    position: relative;
    width: 250px;
    height: 250px;
    margin: 0 auto;
}

.time-circle svg {
    width: 100%;
    height: 100%;
}

.time-circle circle {
    transition: stroke-dashoffset 1s linear;
}

.time-text {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 3.5em;
    font-weight: bold;
    color: #333;
}

/* 控制按钮 */
.controls {
    margin: 30px 0;
    display: flex;
    justify-content: center;
    gap: 15px;
    flex-wrap: wrap;
}

.btn {
    padding: 12px 25px;
    border: none;
    border-radius: 50px;
    font-size: 1.1em;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    min-width: 100px;
}

.btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
}

.btn-start {
    background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);
    color: white;
}

.btn-start:hover:not(:disabled) {
    transform: translateY(-3px);
    box-shadow: 0 10px 20px rgba(76, 175, 80, 0.3);
}

.btn-pause {
    background: linear-gradient(135deg, #FFC107 0%, #FF9800 100%);
    color: white;
}

.btn-pause:hover:not(:disabled) {
    transform: translateY(-3px);
    box-shadow: 0 10px 20px rgba(255, 152, 0, 0.3);
}

.btn-reset {
    background: linear-gradient(135deg, #f44336 0%, #d32f2f 100%);
    color: white;
}

.btn-reset:hover:not(:disabled) {
    transform: translateY(-3px);
    box-shadow: 0 10px 20px rgba(211, 47, 47, 0.3);
}

.btn-save {
    background: linear-gradient(135deg, #2196F3 0%, #1976D2 100%);
    color: white;
    margin-top: 15px;
}

.btn-save:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 20px rgba(33, 150, 243, 0.3);
}

/* 会话信息 */
.session-info {
    background: #f8f9fa;
    border-radius: 15px;
    padding: 20px;
    margin: 20px 0;
    display: flex;
    justify-content: space-around;
    flex-wrap: wrap;
    gap: 10px;
}

.session-info p {
    font-size: 1.1em;
    color: #555;
}

.session-info span {
    font-weight: 600;
    color: #333;
}

/* 设置区域 */
.settings {
    background: #f8f9fa;
    border-radius: 15px;
    padding: 25px;
    margin: 20px 0;
    text-align: left;
}

.settings h3 {
    text-align: center;
    margin-bottom: 20px;
    color: #333;
}

.setting-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
    flex-wrap: wrap;
}

.setting-item label {
    font-weight: 500;
    color: #555;
    margin-bottom: 5px;
}

.setting-item input {
    padding: 10px 15px;
    border: 2px solid #ddd;
    border-radius: 10px;
    font-size: 1em;
    width: 100px;
    text-align: center;
    transition: border-color 0.3s;
}

.setting-item input:focus {
    outline: none;
    border-color: #667eea;
}

/* 历史记录 */
.history {
    background: #f8f9fa;
    border-radius: 15px;
    padding: 25px;
    margin-top: 20px;
}

.history h3 {
    text-align: center;
    margin-bottom: 20px;
    color: #333;
}

.history-item {
    background: white;
    border-radius: 10px;
    padding: 15px;
    margin-bottom: 10px;
    border-left: 4px solid #4CAF50;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

.history-item .time {
    font-weight: 600;
    color: #333;
}

.history-item .details {
    color: #666;
    font-size: 0.9em;
    margin-top: 5px;
}

/* 响应式设计 */
@media (max-width: 600px) {
    .container {
        padding: 20px;
    }
    
    h1 {
        font-size: 2em;
    }
    
    .time-circle {
        width: 200px;
        height: 200px;
    }
    
    .time-text {
        font-size: 2.8em;
    }
    
    .controls {
        flex-direction: column;
        align-items: center;
    }
    
    .btn {
        width: 80%;
    }
    
    .setting-item {
        flex-direction: column;
        align-items: stretch;
    }
    
    .setting-item input {
        width: 100%;
    }
}
