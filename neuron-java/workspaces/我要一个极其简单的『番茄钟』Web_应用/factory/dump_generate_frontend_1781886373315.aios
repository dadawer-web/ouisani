                        timeLeft = breakTime;
                        updateDisplay();
                        
                        // 自动开始休息计时器
                        setTimeout(() => {
                            startTimer();
                        }, 1000);
                        
                    } else {
                        // 休息时间结束，开始新的番茄
                        isBreak = false;
                        totalTime = WORK_TIME;
                        timeLeft = WORK_TIME;
                        updateDisplay();
                        
                        // 自动开始新的番茄
                        setTimeout(() => {
                            startTimer();
                        }, 1000);
                    }
                    
                    startBtn.disabled = false;
                    pauseBtn.disabled = true;
                    
                    // 播放提示音
                    playNotificationSound();
                    
                    return;
                }
                
                updateDisplay();
            }, 1000);
        }

        // 暂停计时器
        function pauseTimer() {
            if (!isRunning) return;
            
            clearInterval(timerInterval);
            isRunning = false;
            startBtn.disabled = false;
            pauseBtn.disabled = true;
        }

        // 重置计时器
        function resetTimer() {
            clearInterval(timerInterval);
            isRunning = false;
            
            if (isBreak) {
                timeLeft = totalTime;
            } else {
                timeLeft = WORK_TIME;
                totalTime = WORK_TIME;
            }
            
            startBtn.disabled = false;
            pauseBtn.disabled = true;
            resetBtn.disabled = true;
            
            updateDisplay();
        }

        // 播放提示音（使用Web Audio API）
        function playNotificationSound() {
            try {
                const audioContext = new (window.AudioContext || window.webkitAudioContext)();
                const oscillator = audioContext.createOscillator();
                const gainNode = audioContext.createGain();
                
                oscillator.connect(gainNode);
                gainNode.connect(audioContext.destination);
                
                oscillator.frequency.value = 800;
                oscillator.type = 'sine';
                gainNode.gain.value = 0.3;
                
                oscillator.start();
                setTimeout(() => {
                    oscillator.stop();
                    audioContext.close();
                }, 200);
            } catch (e) {
                console.log('无法播放提示音:', e);
            }
        }

        // 初始化显示
        updateDisplay();
    </script>
</body>
</html>"""
        
        return html_content
    
    def process_data(self, input_data=None) -> dict:
        """处理数据并生成前端界面"""
        try:
            print("🍅 [generate_frontend] 开始生成番茄钟前端界面...")
            
            # 生成HTML内容
            html_content = self.generate_html()
            
            # 确保输出目录存在
            os.makedirs(os.path.dirname(self.output_html_path), exist_ok=True)
            
            # 保存HTML文件
            with open(self.output_html_path, 'w', encoding='utf-8') as f:
                f.write(html_content)
            
            print(f"✅ [generate_frontend] 前端HTML已保存到: {self.output_html_path}")
            
            result = {
                "status": "success",
                "html_file": self.output_html_path,
                "html_size": len(html_content),
                "timestamp": datetime.now().isoformat(),
                "message": "番茄钟前端界面生成成功"
            }
            
            return result
            
        except Exception as e:
            error_msg = f"生成失败: {str(e)}"
            print(f"❌ [generate_frontend] {error_msg}")
            return {
                "status": "error",
                "error": error_msg,
                "timestamp": datetime.now().isoformat()
            }


def main():
    """主函数"""
    print("=" * 60)
    print("🚀 [generate_frontend] 启动番茄钟前端生成器")
    print("=" * 60)
    
    agent = GenerateFrontendAgent()
    result = agent.run()
    
    if result.get("status") == "success":
        print("🎉 [generate_frontend] 前端生成完成！")
        print(f"📁 文件位置: {result.get('html_file')}")
        print(f"📊 文件大小: {result.get('html_size')} 字节")
    else:
        print("💥 [generate_frontend] 生成失败！")
        print(f"❌ 错误: {result.get('error')}")
    
    return result


if __name__ == "__main__":
    main()
