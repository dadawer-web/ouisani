    <script>
        // 番茄钟配置
        const WORK_TIME = 25 * 60; // 25分钟（秒）
        const SHORT_BREAK = 5 * 60; // 5分钟休息
        const LONG_BREAK = 15 * 60; // 15分钟休息
        const SESSIONS_BEFORE_LONG_BREAK = 4; // 4个番茄后长休息

        let timeLeft = WORK_TIME;
        let totalTime = WORK_TIME;
        let isRunning = false;
        let isBreak = false;
        let timerInterval = null;
        let completedTomatoes = 0;
        let currentSession = 0;

        // DOM元素
        const timerDisplay = document.getElementById('timer');
        const statusDisplay = document.getElementById('status');
        const startBtn = document.getElementById('startBtn');
        const pauseBtn = document.getElementById('pauseBtn');
        const resetBtn = document.getElementById('resetBtn');
        const tomatoCount = document.getElementById('tomatoCount');
        const progress = document.getElementById('progress');
        const breakInfo = document.getElementById('breakInfo');

        // 格式化时间显示
        function formatTime(seconds) {
            const mins = Math.floor(seconds / 60);
            const secs = seconds % 60;
            return `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
        }

        // 更新进度条
        function updateProgress() {
            const progressPercent = (timeLeft / totalTime) * 100;
            progress.style.width = `${progressPercent}%`;
        }

        // 更新显示
        function updateDisplay() {
            timerDisplay.textContent = formatTime(timeLeft);
            updateProgress();
            
            if (isBreak) {
                statusDisplay.textContent = currentSession === 0 ? '休息时间到！' : '休息一下，恢复精力！';
                timerDisplay.style.color = '#2ecc71';
                breakInfo.textContent = currentSession % 4 === 0 && currentSession > 0 
                    ? '🎉 恭喜完成4个番茄！长休息时间！' 
                    : '';
            } else {
                statusDisplay.textContent = '专注工作中...';
                timerDisplay.style.color = '#e74c3c';
                breakInfo.textContent = '';
            }
        }

        // 开始计时器
        function startTimer() {
            if (isRunning) return;
            
            isRunning = true;
            startBtn.disabled = true;
            pauseBtn.disabled = false;
            resetBtn.disabled = false;
            
            timerInterval = setInterval(() => {
                timeLeft--;
                
                if (timeLeft <= 0) {
                    clearInterval(timerInterval);
                    isRunning = false;
                    
                    if (!isBreak) {
                        // 工作时间结束，进入休息
                        completedTomatoes++;
                        currentSession++;
                        tomatoCount.textContent = completedTomatoes;
                        
                        // 决定休息时间长度
                        let breakTime;
                        if (currentSession % SESSIONS_BEFORE_LONG_BREAK === 0) {
                            breakTime = LONG_BREAK;
                        } else {
                            breakTime = SHORT_BREAK;
                        }
                        
                        // 开始休息时间
                        isBreak = true;
                        totalTime = breakTime;
                        timeLeft = breakTime;
                        updateDisplay();
                        
                        // 自动开始休息计时器
                        setTimeout(() => {
                            startTimer();
                        }, 1000);
                        
                    } else {
                        // 休息时间结束，开始新的番茄
                        isBreak = false;
                        totalTime = WORK_TIME;
                        timeLeft = WORK_TIME;
                        updateDisplay();
                        
                        // 自动开始新的番茄
                        setTimeout(() => {
                            startTimer();
                        }, 1000);
                    }
                    
                    startBtn.disabled = false;
                    pauseBtn.disabled = true;
                    
                    // 播放提示音
                    playNotificationSound();
                    
                    return;
                }
                
                updateDisplay();
            }, 1000);
        }

        // 暂停计时器
        function pauseTimer() {
            if (!isRunning) return;
            
            clearInterval(timerInterval);
            isRunning = false;
            startBtn.disabled = false;
            pauseBtn.disabled = true;
        }

        // 重置计时器
        function resetTimer() {
            clearInterval(timerInterval);
            isRunning = false;
            
            if (isBreak) {
                timeLeft = totalTime;
            } else {
                timeLeft = WORK_TIME;
                totalTime = WORK_TIME;
            }
            
            startBtn.disabled = false;
            pauseBtn.disabled = true;
            resetBtn.disabled = true;
            
            updateDisplay();
        }

        // 播放提示音（使用Web Audio API）
        function playNotificationSound() {
            try {
                const audioContext = new (window.AudioContext || window.webkitAudioContext)();
                const oscillator = audioContext.createOscillator();
                const gainNode = audioContext.createGain();
                
                oscillator.connect(gainNode);
                gainNode.connect(audioContext.destination);
                
                oscillator.frequency.value = 800;
                oscillator.type = 'sine';
                gainNode.gain.value = 0.3;
                
                oscillator.start();
                setTimeout(() => {
                    oscillator.stop();
                    audioContext.close();
                }, 200);
            } catch (e) {
                console.log('无法播放提示音:', e);
            }
        }

        // 初始化显示
        updateDisplay();
    </script>
</body>
